model Product {
  id                   String     @id @default(cuid())
  slug                 String     @unique
  title                String
  description          String
  priceLabel           String
  priceArs             Int?
  amazonKindleUrl      String?
  amazonKindlePrice    String?
  amazonPaperbackUrl   String?
  amazonPaperbackPrice String?
  lemonVariantId       String?
  coverImage           String?
  coverImagePosition   Int        @default(50)
  heroImage            String?
  heroImagePosition    Int        @default(50)
  galleryImages        String[]   @default([])
  contentHighlights    Json       @default("[]")
  testimonials         Json       @default("[]")
  audienceText         String?
  // Cantidad de ventas/descargas a mostrar en la ficha ("X ya lo compraron").
  // Se carga a mano desde el admin, no se calcula solo a partir de las compras reales.
  salesCount           Int?
  fileUrl              String?
  published            Boolean    @default(true)
  createdAt            DateTime   @default(now())
  purchases            Purchase[]
  featuredInArticles   Article[]
}
