// Zodiac Noir — modelo de datos
// Motor recomendado: PostgreSQL (Vercel Postgres, Neon o Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  confirmed        Boolean   @default(false)
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now())
  confirmedAt      DateTime?
  // Fecha en que la persona se dio de baja del boletín. Si tiene fecha, no recibe más correos.
  unsubscribedAt   DateTime?
  // De dónde llegó la suscripción: la etiqueta utm_source del enlace (youtube, instagram…) o la parte del sitio
  // desde donde se suscribió (web-portada, web-articulo…). Vacío en los suscriptores anteriores a este registro.
  source           String?
}

model MembershipPlan {
  id             String         @id @default(cuid())
  name           String
  slug           String         @unique
  description    String
  priceLabel     String
  interval       String
  lemonVariantId String?
  // Precio en ARS para cobrar la suscripción con Mercado Pago (Suscripciones/Preapproval).
  // Dejalo vacío si este plan solo se vende por Lemon Squeezy.
  priceArs       Int?
  // Precio en dólares (USD). Es el precio que se publica; al cobrar con Mercado Pago se convierte
  // a pesos al dólar blue + margen, y con PayPal se cobra directamente en dólares.
  priceUsd       Float?
  // Plan de facturación creado en PayPal (se crea solo la primera vez que alguien paga con PayPal)
  // y el precio en USD con el que se creó: si cambia el precio, se crea un plan nuevo.
  paypalPlanId   String?
  paypalPlanUsd  Float?
  featured       Boolean        @default(false)
  benefits       String
  createdAt      DateTime       @default(now())
  subscriptions  Subscription[]
}

model Subscription {
  id                       String          @id @default(cuid())
  email                    String          @unique
  status                   String
  provider                 String          @default("lemonsqueezy")
  lemonSubscriptionId      String?         @unique
  lemonCustomerId          String?
  // ID de la suscripción (preapproval) en Mercado Pago.
  mercadoPagoPreapprovalId String?         @unique
  // ID de la suscripción en PayPal (empieza con "I-").
  paypalSubscriptionId     String?         @unique
  renewsAt                 DateTime?
  endsAt                   DateTime?
  plan                     MembershipPlan? @relation(fields: [planId], references: [id])
  planId                   String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
}

model Product {
  id                   String     @id @default(cuid())
  slug                 String     @unique
  title                String
  description          String
  priceLabel           String
  priceArs             Int?
  // Precio en dólares (USD): es el que se publica en la tienda. Mercado Pago lo cobra en pesos
  // (dólar blue + margen) y PayPal en dólares. Si está vacío se usa priceArs (productos viejos).
  priceUsd             Float?
  // "book" = libro / e-book · "pdf" = material PDF descargable (calendarios, cuadernos imprimibles…)
  kind                 String     @default("book")
  amazonKindleUrl      String?
  amazonKindlePrice    String?
  amazonPaperbackUrl   String?
  amazonPaperbackPrice String?
  lemonVariantId       String?
  coverImage           String?
  coverImagePosition   Int        @default(50)
  heroImage            String?
  heroImagePosition    Int        @default(50)
  galleryImages        String[]   @default([])
  contentHighlights    Json       @default("[]")
  testimonials         Json       @default("[]")
  audienceText         String?
  // Cantidad de ventas/descargas a mostrar en la ficha ("X ya lo compraron").
  // Se carga a mano desde el admin, no se calcula solo a partir de las compras reales.
  salesCount           Int?
  fileUrl              String?
  // Video de presentación del producto: se sube desde el panel (Vercel Blob) y se muestra en la ficha pública.
  videoUrl             String?
  // --- SEO (todos opcionales: si están vacíos, la web usa el título y la descripción del producto) ---
  // Título que aparece en Google y en la pestaña del navegador (ideal: hasta ~60 caracteres).
  metaTitle            String?
  // Descripción que aparece bajo el título en Google (ideal: 120 a 155 caracteres).
  metaDescription      String?
  // Palabra clave principal; solo se usa para la lista de control del panel de admin.
  focusKeyword         String?
  // Texto alternativo de la portada (lo leen Google y los lectores de pantalla).
  coverImageAlt        String?
  // Etiquetas del producto (se publican como "keywords" en los datos estructurados).
  tags                 String[]   @default([])
  // Preguntas frecuentes: lista de { question, answer }. Se muestran en la página del producto y alimentan el schema FAQPage.
  faq                  Json       @default("[]")
  published            Boolean    @default(true)
  createdAt            DateTime   @default(now())
  purchases            Purchase[]
  featuredInArticles   Article[]
}

model Purchase {
  id                   String   @id @default(cuid())
  email                String
  product              Product  @relation(fields: [productId], references: [id])
  productId            String
  provider             String   @default("lemonsqueezy")
  lemonOrderId         String?  @unique
  mercadoPagoPaymentId String?  @unique
  // ID de la orden en PayPal (cuando se pagó con PayPal).
  paypalOrderId        String?  @unique
  status               String
  createdAt            DateTime @default(now())

  @@index([email])
}

// Pedidos de lecturas personalizadas (carta natal y revolución solar).
// El precio se publica en USD pero Mercado Pago cobra en pesos: al crear el pedido se fija
// la cotización (exchangeRate) y el monto en ARS (priceArs) que se cobra.
// Estados: pending (esperando el pago) · paid (pagado, por entregar) · delivered (PDF enviado)
//          · refunded (devuelto) · cancelled (no se pudo iniciar el pago).
model ReadingOrder {
  id                   String    @id @default(cuid())
  // "carta-natal" | "revolucion-solar" (ver src/lib/lecturas.ts)
  service              String
  status               String    @default("pending")
  email                String
  name                 String
  // Datos de nacimiento. birthDate = AAAA-MM-DD; birthTime = HH:MM (vacío si no se conoce).
  birthDate            String
  birthTime            String?
  // "exact" | "approx" | "unknown"
  birthTimeMode        String    @default("exact")
  birthPlace           String
  // Área de interés elegida (ver READING_FOCUS_OPTIONS en src/lib/lecturas.ts)
  focus                String
  about                String?   @db.Text
  // Solo para la revolución solar: año del cumpleaños y lugar donde estará esa persona ese día.
  solarYear            Int?
  solarPlace           String?
  priceUsd             Int
  // "mercadopago" (cobro en pesos) o "paypal" (cobro en dólares). En los pedidos de PayPal
  // exchangeRate y priceArs quedan en 0, porque no hay conversión.
  provider             String    @default("mercadopago")
  exchangeRate         Float
  priceArs             Int
  mercadoPagoPaymentId String?   @unique
  paypalOrderId        String?   @unique
  paidAt               DateTime?
  // Fecha límite de entrega: momento del pago + horas de entrega (READING_DELIVERY_HOURS).
  deliverBy            DateTime?
  deliveredAt          DateTime?
  fileUrl              String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([email])
  @@index([status, deliverBy])
}

// Ajustes del sitio que se cambian desde el panel (clave → valor en texto).
// Hoy se usa para "readings_enabled": "true" muestra las lecturas al público, cualquier otro valor las oculta.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Article {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  content        String    @db.Text
  coverImage     String?
  coverImagePosX Int       @default(50)
  coverImagePosY Int       @default(50)
  category       String
  sign           String?
  authorName     String
  authorRole     String
  readingTimeMin Int
  published      Boolean   @default(false)
  publishedAt    DateTime?
  // Si es true, solo lo pueden leer completo los miembros con membresía activa.
  isPremium      Boolean   @default(false)
  // --- SEO (todos opcionales: si están vacíos, la web usa título y copete) ---
  // Título que aparece en Google y en la pestaña del navegador (ideal: hasta ~60 caracteres).
  metaTitle        String?
  // Descripción que aparece bajo el título en Google (ideal: 120 a 155 caracteres).
  metaDescription  String?
  // Palabra clave principal; solo se usa para la lista de control del panel de admin.
  focusKeyword     String?
  // Texto alternativo de la imagen de portada (lo leen Google y los lectores de pantalla).
  coverImageAlt    String?
  // Etiquetas del artículo (se publican como "keywords" en los datos estructurados).
  tags             String[]  @default([])
  // Preguntas frecuentes: lista de { question, answer }. Se muestran al final y alimentan el schema FAQPage.
  faq              Json      @default("[]")
  featuredProduct   Product? @relation(fields: [featuredProductId], references: [id])
  featuredProductId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  views          ArticleView[]
}

// Vistas de cada artículo, un número por artículo y por día (sin datos personales).
// Se suma desde /api/views y se lee en el panel de administración.
model ArticleView {
  id        String  @id @default(cuid())
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String
  // Día en horario de Argentina, formato AAAA-MM-DD
  day       String
  views     Int     @default(0)

  @@unique([articleId, day])
  @@index([day])
}

// Vistas de la tienda, un número por destino y por día (sin datos personales).
// target = "tienda" (la página /tienda) o "producto:<id>" (la ficha de un libro).
// Se suma desde /api/store-views y se lee en /admin/productos.
model StoreView {
  id     String @id @default(cuid())
  target String
  // Día en horario de Argentina, formato AAAA-MM-DD
  day    String
  views  Int    @default(0)

  @@unique([target, day])
  @@index([day])
}
