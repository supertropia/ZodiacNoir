# --- Panel de administración ---
# Emails autorizados a entrar a /admin, separados por coma (deben coincidir con tu cuenta de Google).
ADMIN_EMAILS="vos@gmail.com"

# --- Subida de imágenes (Vercel Blob) ---
# Se completa sola al activar "Storage → Blob" en el panel de tu proyecto de Vercel y conectarlo.
# En local podés dejarla vacía: el panel te va a avisar y podrás pegar URLs de imágenes externas mientras tanto.
BLOB_READ_WRITE_TOKEN=""

# --- Base de datos (Postgres: Vercel Postgres, Neon o Supabase) ---
DATABASE_URL="postgresql://usuario:password@host:5432/zodiacnoir"

# --- NextAuth ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplazar-con-un-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (console.cloud.google.com > APIs y servicios > Credenciales) ---
GOOGLE_CLIENT_ID="tu-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"

# --- Envío de newsletter (Resend: resend.com) ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
NEWSLETTER_FROM="Zodiac Noir <boletin@tu-dominio.com>"

# --- Formulario de contacto ---
# Email propio donde querés recibir los mensajes del formulario de /contacto.
CONTACT_TO_EMAIL="hola@tu-dominio.com"

# --- Pagos (Lemon Squeezy: lemonsqueezy.com) ---
# Subdominio de tu tienda en Lemon Squeezy (sin ".lemonsqueezy.com"), ej. si tu tienda es
# "zodiacnoir.lemonsqueezy.com" el valor es "zodiacnoir".
LEMONSQUEEZY_STORE="tu-tienda"
# Secreto que definís vos mismo al crear el webhook en Lemon Squeezy (Settings → Webhooks).
LEMONSQUEEZY_WEBHOOK_SECRET="reemplazar-con-un-valor-aleatorio-seguro"

# --- Google AdSense ---
# Tu Publisher ID de AdSense, formato "ca-pub-XXXXXXXXXXXXXXXX". Activa el script de anuncios
# y genera /ads.txt automáticamente.
NEXT_PUBLIC_ADSENSE_CLIENT=""
